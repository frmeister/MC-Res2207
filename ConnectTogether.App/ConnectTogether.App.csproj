<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ConnectTogether.App</RootNamespace>
    <AssemblyName>ConnectTogether</AssemblyName>
    <Product>ConnectTogether</Product>
    <Version>0.1.0</Version>
    <!-- Иконка генерируется из знака командой export-icon, см. Diagnostics/DevTools.cs -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Шрифты интерфейса (SIL OFL 1.1, лицензии лежат рядом) -->
    <Resource Include="Assets\Fonts\*.ttf" />
    <None Include="Assets\Fonts\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MC-Ref2207-NetSocketLib\MCTunnel.Core.Network.csproj" />
  </ItemGroup>

</Project>
