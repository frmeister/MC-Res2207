<!-- 3a–3g. Состояния и ошибки: что случилось, что делать дальше, технические детали — в «Подробнее» -->
<UserControl x:Class="ConnectTogether.App.Views.StateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:ConnectTogether.App.Controls"
             xmlns:vm="clr-namespace:ConnectTogether.App.ViewModels">
    <UserControl.Resources>
        <!-- Тон состояния: предупреждение (жёлтый) или ошибка (красный) -->
        <Style x:Key="ToneBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WnSoft}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Wn}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StateTone.Error}">
                    <Setter Property="Background" Value="{DynamicResource ErSoft}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Er}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Width="{Binding ContentWidth}" Margin="0,24,0,32" HorizontalAlignment="Center" VerticalAlignment="Center">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="24" VerticalAlignment="Top" Style="{StaticResource ToneBadge}">
                    <ctl:Icon Kind="{Binding Icon}" Width="24" Height="24" />
                </Border>
                <StackPanel Margin="16,0,0,0">
                    <TextBlock Style="{StaticResource T.StateTitle}" Text="{Binding Title}" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource T.Lead}" Text="{Binding Description}" />
                </StackPanel>
            </DockPanel>

            <!-- Обратный отсчёт переподключения (3f) -->
            <Border Margin="0,22,0,0" Padding="20,18" Style="{StaticResource Card}"
                    Visibility="{Binding IsCountdown, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="56" Height="56">
                        <ctl:CountdownRing Progress="{Binding Progress}" />
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Seconds}" FontSize="20"
                                   FontFamily="{StaticResource FontMono}" FontWeight="{StaticResource Mono700}" />
                    </Grid>
                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding CountdownTitle}" />
                        <TextBlock Margin="0,3,0,0" FontSize="13" Foreground="{DynamicResource Tx3}" Text="{Binding AttemptText}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Что сделать -->
            <Border Margin="0,22,0,0" Padding="22,20" Style="{StaticResource Card}"
                    Visibility="{Binding HasTips, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Tips}" Focusable="False" ItemTemplate="{StaticResource NumberedItemTemplate}" />
            </Border>

            <!-- Варианты обхода сложной сети (3b) -->
            <ItemsControl Margin="0,22,-12,0" ItemsSource="{Binding Options}" Focusable="False"
                          Visibility="{Binding HasOptions, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:StateOption}">
                        <Border Margin="0,0,12,0" Padding="16" Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Tx3}" Text="{Binding Tag}" />
                                    <Border Width="34" Height="34" CornerRadius="9" HorizontalAlignment="Left" Background="{DynamicResource Sf3}">
                                        <ctl:Icon Kind="{Binding Icon}" Width="17" Height="17" />
                                    </Border>
                                </DockPanel>
                                <TextBlock Margin="0,10,0,0" FontSize="15" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,10,0,0" FontSize="13" LineHeight="19" LineStackingStrategy="BlockLineHeight"
                                           TextWrapping="Wrap" Foreground="{DynamicResource Tx2}" Text="{Binding Description}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Свой адрес для «Впустить по адресу» у хоста -->
            <Border Margin="0,12,0,0" Padding="16,12" Style="{StaticResource Card}"
                    Visibility="{Binding MyAddress, Converter={StaticResource NullToCollapsed}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Height="38" Padding="14,0" Style="{StaticResource Btn.Secondary}" ctl:Ui.Icon="copy"
                            Content="Скопировать" Command="{Binding CopyMyAddressCommand}" />
                    <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Tx3}">
                        <Run Text="Ваш адрес для хоста:" />
                        <Run Text="{Binding MyAddress, Mode=OneWay}" FontFamily="{StaticResource FontMono}" FontWeight="{StaticResource Mono600}"
                             FontSize="15" Foreground="{DynamicResource Tx}" />
                    </TextBlock>
                </DockPanel>
            </Border>

            <StackPanel Margin="0,22,0,0" Orientation="Horizontal">
                <Button Height="44" Padding="20,0" FontSize="15" Style="{StaticResource Btn.Primary}" ctl:Ui.Icon="refresh" ctl:Ui.IconSize="17"
                        Content="{Binding PrimaryLabel}" Command="{Binding PrimaryCommand}" IsDefault="True" />
                <Button Margin="10,0,0,0" Height="44" Style="{StaticResource Btn.Secondary}"
                        Content="{Binding SecondaryLabel}" Command="{Binding SecondaryCommand}" />
            </StackPanel>

            <Border Margin="0,22,0,0" Padding="0,14,0,0" BorderBrush="{DynamicResource Bd}" BorderThickness="0,1,0,0">
                <StackPanel>
                    <ToggleButton Style="{StaticResource Toggle.Details}" IsChecked="{Binding DetailsOpen}" />
                    <Border Margin="0,10,0,0" Padding="14,12" CornerRadius="8" Background="{DynamicResource Sf}"
                            Visibility="{Binding DetailsOpen, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Details}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,0,0,2" Style="{StaticResource T.Details}" Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
