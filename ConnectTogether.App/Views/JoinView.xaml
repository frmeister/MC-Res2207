<!-- 1g. Присоединение по адресу хоста -->
<UserControl x:Class="ConnectTogether.App.Views.JoinView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:ConnectTogether.App.Controls">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="32,18">
            <Button HorizontalAlignment="Left" Style="{StaticResource Btn.Back}" Content="Назад" Command="{Binding BackCommand}" IsCancel="True" />
        </Border>

        <StackPanel Width="500" Margin="0,0,0,80" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource T.ScreenTitle}" Text="Присоединиться по адресу" />
            <TextBlock Margin="0,6,0,0" FontSize="15" Foreground="{DynamicResource Tx2}" Text="Введите адрес, который прислал хост." />

            <TextBlock Margin="0,24,0,0" Style="{StaticResource T.Label}" Text="Адрес комнаты" />
            <TextBox x:Name="AddressBox" Margin="0,8,0,0" Style="{StaticResource TextBox.Address}" ctl:Ui.Placeholder="203.0.113.5:47312"
                     ctl:Ui.HasError="{Binding HasError}" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Margin="0,8,0,0" Style="{StaticResource T.Hint}"
                       Text="Можно вставить сообщение от друга целиком — адрес найдём сами. Порт можно не указывать, если он стандартный: 47312."
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
            <DockPanel Margin="0,8,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <ctl:Icon DockPanel.Dock="Left" Kind="alert" Width="14" Height="14" Margin="0,2,0,0" VerticalAlignment="Top"
                          Foreground="{DynamicResource Er}" />
                <TextBlock Margin="6,0,0,0" FontSize="13" LineHeight="18" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                           Foreground="{DynamicResource Er}" Text="{Binding Error}" />
            </DockPanel>

            <Button Margin="0,24,0,0" Height="50" FontSize="16" Style="{StaticResource Btn.Primary}" ctl:Ui.CornerRadius="10"
                    IsDefault="True" Command="{Binding ConnectCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Подключиться" VerticalAlignment="Center" />
                    <TextBlock Margin="10,0,0,0" Text="Enter" VerticalAlignment="Center" FontSize="12" Opacity="0.7"
                               FontFamily="{StaticResource FontMono}" FontWeight="{StaticResource Mono500}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </DockPanel>
</UserControl>
