<!-- 1j / 1k / 2c. Комната игрока: как зайти в игру, кто в комнате, чат -->
<UserControl x:Class="ConnectTogether.App.Views.PlayerRoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:ConnectTogether.App.Controls"
             xmlns:vm="clr-namespace:ConnectTogether.App.ViewModels"
             xmlns:views="clr-namespace:ConnectTogether.App.Views">
    <UserControl.Resources>
        <!-- Цвет качества связи: отлично / нормально / плохо -->
        <Style x:Key="QualityText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Ok}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Quality}" Value="{x:Static vm:PingQuality.Fair}">
                    <Setter Property="Foreground" Value="{DynamicResource Wn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Quality}" Value="{x:Static vm:PingQuality.Poor}">
                    <Setter Property="Foreground" Value="{DynamicResource Er}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QualityBars" TargetType="ctl:PingBars">
            <Setter Property="ActiveBrush" Value="{DynamicResource Ok}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Quality}" Value="{x:Static vm:PingQuality.Fair}">
                    <Setter Property="ActiveBrush" Value="{DynamicResource Wn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Quality}" Value="{x:Static vm:PingQuality.Poor}">
                    <Setter Property="ActiveBrush" Value="{DynamicResource Er}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- Шапка комнаты -->
        <DockPanel>
            <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="12" Background="{DynamicResource Sf3}">
                <ctl:Icon Kind="{Binding Game.Icon}" Width="24" Height="24" />
            </Border>
            <Button DockPanel.Dock="Right" Height="40" Padding="16,0" VerticalAlignment="Center" Style="{StaticResource Btn.Secondary}"
                    ctl:Ui.Icon="logout" ctl:Ui.IconSize="17" Content="Выйти из комнаты" Command="{Binding LeaveCommand}" />
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource T.BlockTitle}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                    <ContentControl Style="{StaticResource Chip}" Background="{DynamicResource OkSoft}" Foreground="{DynamicResource Ok}"
                                    ctl:Ui.Icon="checkCircle" Content="Подключено" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Tx2}">
                        <Run Text="Пинг до хоста" />
                        <Run Text="{Binding PingText, Mode=OneWay}" FontFamily="{StaticResource FontMono}" FontWeight="{StaticResource Mono600}"
                             Foreground="{DynamicResource Tx}" />
                    </TextBlock>
                    <ctl:PingBars Margin="7,0,0,0" Height="13" VerticalAlignment="Center" Level="{Binding QualityLevel}" Style="{StaticResource QualityBars}" />
                    <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Text="{Binding QualityText}"
                               Style="{StaticResource QualityText}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <DockPanel>
                <!-- Кто в комнате -->
                <Border DockPanel.Dock="Bottom" Margin="0,16,0,0" Padding="16,12" Style="{StaticResource Card}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="13" Foreground="{DynamicResource Tx3}" Text="В комнате" VerticalAlignment="Center" />
                        <ItemsControl Margin="12,0,0,0" ItemsSource="{Binding Roster}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RosterItem}">
                                    <StackPanel x:Name="Item" Margin="16,0,0,0" Orientation="Horizontal">
                                        <Border Width="24" Height="24" CornerRadius="12" Background="{Binding Avatar}">
                                            <TextBlock Text="{Binding Initial}" FontSize="11" FontWeight="Bold" Foreground="#14161B"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Margin="7,0,0,0" FontSize="14" Text="{Binding Name}" VerticalAlignment="Center" />
                                        <TextBlock Margin="4,0,0,0" FontSize="14" Text="{Binding Role}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Tx3}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                            <Setter TargetName="Item" Property="Margin" Value="0" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Как зайти в игру: текст и команда берутся из интеграции -->
                <Border Padding="32,30" Style="{StaticResource Card14}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Как зайти в игру" FontSize="26" LineHeight="32"
                                   LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" />

                        <!-- Консоль игры: «Нажмите F1 в игре и введите:» -->
                        <TextBlock DockPanel.Dock="Top" Margin="0,22,0,0" FontSize="18" LineHeight="26" LineStackingStrategy="BlockLineHeight"
                                   Visibility="{Binding HasConsoleKey, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="Нажмите" />
                            <InlineUIContainer BaselineAlignment="Center">
                                <Border MinWidth="30" Height="26" Padding="6,0" CornerRadius="6" Background="{DynamicResource Sf3}"
                                        BorderBrush="{DynamicResource Bd2}" BorderThickness="1,1,1,3">
                                    <TextBlock Text="{Binding ConsoleKey}" FontFamily="{StaticResource FontMono}" FontWeight="{StaticResource Mono600}"
                                               FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </InlineUIContainer>
                            <Run Text="в игре и введите:" />
                        </TextBlock>

                        <!-- Меню игры: «Сетевая игра → Прямое подключение → введите адрес:» -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,22,0,0" Orientation="Horizontal"
                                    Visibility="{Binding HasMenuPath, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding MenuPath}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <ctl:Icon x:Name="Arrow" Kind="arrowRight" Width="18" Height="18" Margin="10,0"
                                                      Foreground="{DynamicResource Tx3}" VerticalAlignment="Center" />
                                            <Border Height="34" Padding="13,0" CornerRadius="8" Background="{DynamicResource Sf3}">
                                                <TextBlock Text="{Binding}" FontSize="17" FontWeight="Medium" VerticalAlignment="Center" />
                                            </Border>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                                <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ctl:Icon Kind="arrowRight" Width="18" Height="18" Margin="10,0" Foreground="{DynamicResource Tx3}" VerticalAlignment="Center" />
                            <TextBlock Text="введите адрес:" FontSize="17" FontWeight="Medium" Foreground="{DynamicResource Tx2}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Что ввести в игре -->
                        <Border DockPanel.Dock="Top" Margin="0,14,0,0" Padding="22,10,10,10" CornerRadius="12" Background="{DynamicResource Bg}"
                                BorderBrush="{DynamicResource Bd2}" BorderThickness="1">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Margin="12,0,0,0" Height="44" Padding="18,0" FontSize="15" Style="{StaticResource Btn.Primary}"
                                        ctl:Ui.Icon="{Binding CopyIcon}" ctl:Ui.IconSize="17" ctl:Ui.IconStroke="1.8"
                                        Content="{Binding CopyLabel}" Command="{Binding CopyCommand}" />
                                <TextBox Text="{Binding CommandText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                         Foreground="{DynamicResource Tx}" CaretBrush="Transparent" SelectionBrush="{DynamicResource Selection}"
                                         FontFamily="{StaticResource FontMono}" FontWeight="{StaticResource Mono600}"
                                         FontSize="{Binding CommandFontSize}" VerticalAlignment="Center" Padding="0" Margin="-2,0,0,0"
                                         FocusVisualStyle="{x:Null}">
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden"
                                                          VerticalScrollBarVisibility="Hidden" />
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>
                            </DockPanel>
                        </Border>

                        <DockPanel DockPanel.Dock="Top" Margin="0,22,0,0">
                            <ctl:Icon DockPanel.Dock="Left" Kind="info" Width="17" Height="17" Margin="0,1,0,0" VerticalAlignment="Top"
                                      Foreground="{DynamicResource Tx3}" />
                            <TextBlock Margin="10,0,0,0" FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Tx2}"
                                       Text="Адрес 127.0.0.1 — это нормально. ConnectTogether принимает игру хоста и передаёт её прямо на ваш компьютер." />
                        </DockPanel>

                        <!-- Автозапуск игры — следующая версия -->
                        <Border DockPanel.Dock="Bottom" Padding="0,20,0,0" BorderBrush="{DynamicResource Bd}" BorderThickness="0,1,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Padding="16,0" Style="{StaticResource Btn.Secondary}" IsEnabled="False" ctl:Ui.Icon="play" ctl:Ui.IconSize="15"
                                        ctl:Ui.IconGap="9" ToolTipService.ShowOnDisabled="True" ToolTip="Появится в следующей версии">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Запустить игру" VerticalAlignment="Center" />
                                        <Border Margin="9,0,0,0" Height="20" Padding="7,0" CornerRadius="10" BorderBrush="{DynamicResource Bd2}"
                                                BorderThickness="1" VerticalAlignment="Center">
                                            <TextBlock Text="скоро" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Tx2}"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                                <TextBlock Margin="14,0,0,0" MaxWidth="300" VerticalAlignment="Center" Style="{StaticResource T.Hint}"
                                           Text="Позже приложение само откроет игру и подключит вас к серверу." />
                            </StackPanel>
                        </Border>
                        <Border />
                    </DockPanel>
                </Border>
            </DockPanel>

            <views:ChatPanel Grid.Column="2" />
        </Grid>
    </Grid>
</UserControl>
