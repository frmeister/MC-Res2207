<!-- 1l. Интеграции -->
<UserControl x:Class="ConnectTogether.App.Views.IntegrationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:ConnectTogether.App.Controls"
             xmlns:models="clr-namespace:ConnectTogether.App.Models">
    <UserControl.Resources>
        <!-- Столбцы таблицы: игра, версия, автор, статус; между ними 16 -->
        <Style x:Key="TableRow" TargetType="Grid">
            <Setter Property="Margin" Value="18,0" />
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="64,44">
        <DockPanel>
            <Button DockPanel.Dock="Right" Padding="16,0" VerticalAlignment="Bottom" Style="{StaticResource Btn.Secondary}"
                    ctl:Ui.Icon="file" ctl:Ui.IconSize="17" Content="Добавить интеграцию из файла" Command="{Binding AddFromFileCommand}" />
            <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource T.ScreenTitle}" Text="Интеграции" />
                <TextBlock Margin="0,6,0,0" Style="{StaticResource T.Lead}"
                           Text="Интеграция подсказывает ConnectTogether, где искать сервер игры и как объяснить игрокам, куда подключаться." />
            </StackPanel>
        </DockPanel>

        <Border Margin="0,28,0,0" Style="{StaticResource Card}" ClipToBounds="True">
            <StackPanel>
                <Border Padding="0,10" BorderBrush="{DynamicResource Bd}" BorderThickness="0,0,0,1">
                    <Grid Style="{StaticResource TableRow}" TextElement.FontSize="12" TextElement.FontWeight="Medium"
                          TextElement.Foreground="{DynamicResource Tx3}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Игра" />
                        <TextBlock Grid.Column="2" Text="Версия" />
                        <TextBlock Grid.Column="4" Text="Автор" />
                        <TextBlock Grid.Column="6" Text="Статус" TextAlignment="Right" />
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:GameIntegration}">
                            <Grid>
                                <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource Bd}"
                                        Visibility="{Binding RelativeSource={RelativeSource PreviousData}, Converter={StaticResource NullToCollapsed}}" />
                                <Grid Margin="18,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <DockPanel>
                                        <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource Sf3}">
                                            <ctl:Icon Kind="{Binding Icon}" Width="19" Height="19" />
                                        </Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="15" FontWeight="Medium" Text="{Binding Name}" />
                                            <TextBlock Margin="0,1,0,0" FontSize="13" Foreground="{DynamicResource Tx3}" Text="{Binding ListSubtitle}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Tx2}"
                                               FontFamily="{StaticResource FontMono}" FontWeight="{StaticResource Mono500}" Text="{Binding Version}" />
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource Tx2}"
                                               Text="{Binding Author}" TextTrimming="CharacterEllipsis" />
                                    <ContentControl Grid.Column="6" HorizontalAlignment="Right" Style="{StaticResource Chip}"
                                                    Background="{DynamicResource OkSoft}" Foreground="{DynamicResource Ok}"
                                                    ctl:Ui.Icon="check" ctl:Ui.IconStroke="2.6" Content="Работает" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <TextBlock Margin="0,28,0,0" FontSize="14" LineHeight="21" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource Tx3}">
            <Run Text="Хотите добавить свою игру? Интеграцию может написать любой —" />
            <Hyperlink Style="{StaticResource Link}" Command="{Binding GuideCommand}">как сделать интеграцию</Hyperlink><Run Text="." />
        </TextBlock>
    </StackPanel>
</UserControl>
