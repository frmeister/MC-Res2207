<!-- Строка игрока: аватар, имя, статус, качество связи, пинг. DataContext — PlayerItem. -->
<UserControl x:Class="ConnectTogether.App.Views.PlayerRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:ConnectTogether.App.Controls"
             xmlns:vm="clr-namespace:ConnectTogether.App.ViewModels"
             xmlns:models="clr-namespace:ConnectTogether.App.Models">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLeft}" Value="True">
                    <Setter Property="Opacity" Value="0.6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Grid>
        <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource Bd}"
                Visibility="{Binding RelativeSource={RelativeSource PreviousData}, Converter={StaticResource NullToCollapsed}}" />
        <DockPanel Margin="16,10">
            <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" Background="{Binding Avatar}">
                <TextBlock Text="{Binding Initial}" FontSize="13" FontWeight="Bold" Foreground="#14161B"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel DockPanel.Dock="Right" MinWidth="150" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock FontSize="13" Foreground="{DynamicResource Tx3}" Text="{Binding QualityText}" VerticalAlignment="Center" />
                <TextBlock Margin="10,0,0,0" MinWidth="48" TextAlignment="Right" FontSize="13" Text="{Binding PingText}" VerticalAlignment="Center"
                           FontFamily="{StaticResource FontMono}" FontWeight="{StaticResource Mono600}" />
                <ctl:PingBars Margin="10,0,0,0" Height="14" Level="{Binding QualityLevel}" VerticalAlignment="Center">
                    <ctl:PingBars.Style>
                        <Style TargetType="ctl:PingBars">
                            <Setter Property="ActiveBrush" Value="{DynamicResource Ok}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Quality}" Value="{x:Static vm:PingQuality.Fair}">
                                    <Setter Property="ActiveBrush" Value="{DynamicResource Wn}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Quality}" Value="{x:Static vm:PingQuality.Poor}">
                                    <Setter Property="ActiveBrush" Value="{DynamicResource Er}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ctl:PingBars.Style>
                </ctl:PingBars>
            </StackPanel>

            <StackPanel Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock FontSize="15" FontWeight="Medium" Text="{Binding Name}" VerticalAlignment="Center" />
                <ContentControl Margin="10,0,0,0" Content="{Binding StatusText}" ctl:Ui.Icon="{Binding StatusIcon}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl" BasedOn="{StaticResource Chip}">
                            <Setter Property="Background" Value="{DynamicResource OkSoft}" />
                            <Setter Property="Foreground" Value="{DynamicResource Ok}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:PlayerStatus.Host}">
                                    <Setter Property="Background" Value="{DynamicResource AcSoft}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Ac}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:PlayerStatus.InRoom}">
                                    <Setter Property="Background" Value="{DynamicResource Sf3}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Tx}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:PlayerStatus.Joining}">
                                    <Setter Property="Background" Value="{DynamicResource Sf3}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Tx2}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:PlayerStatus.Left}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource Tx3}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
