<!-- 1m. Настройки -->
<UserControl x:Class="ConnectTogether.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:ConnectTogether.App.Controls">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="64,44">
            <TextBlock Style="{StaticResource T.ScreenTitle}" Text="Настройки" />

            <Grid Margin="0,28,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Border Padding="22" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Профиль" />
                            <TextBlock Margin="0,16,0,0" Style="{StaticResource T.Label}" Text="Ваше имя в комнате" />
                            <TextBox Margin="0,7,0,0" Style="{StaticResource TextBox.Field}" MaxLength="24"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,20,0,0" Padding="22" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Оформление" />
                            <TextBlock Margin="0,16,0,0" Style="{StaticResource T.Label}" Text="Тема" />
                            <Border Margin="0,7,0,0" Padding="3" CornerRadius="10" Background="{DynamicResource Bg}"
                                    BorderBrush="{DynamicResource Bd2}" BorderThickness="1">
                                <UniformGrid Columns="3">
                                    <RadioButton Style="{StaticResource Radio.Segment}" GroupName="theme" ctl:Ui.Icon="moon"
                                                 Content="Тёмная" IsChecked="{Binding IsDark}" />
                                    <RadioButton Style="{StaticResource Radio.Segment}" GroupName="theme" ctl:Ui.Icon="sun"
                                                 Content="Светлая" IsChecked="{Binding IsLight}" />
                                    <RadioButton Style="{StaticResource Radio.Segment}" GroupName="theme" ctl:Ui.Icon="monitor"
                                                 Content="Как в Windows" IsChecked="{Binding IsSystem}" />
                                </UniformGrid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Padding="22" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Поддержка" />
                            <TextBlock Margin="0,14,0,0" FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                       TextWrapping="Wrap" Foreground="{DynamicResource Tx2}"
                                       Text="Если что-то не работает, приложите диагностику к сообщению в поддержку. В ней версия приложения, сведения о сети и последние события — без личных данных." />
                            <WrapPanel Margin="0,14,0,0">
                                <Button Margin="0,0,10,0" Height="40" Padding="12,0" Style="{StaticResource Btn.Secondary}"
                                        ctl:Ui.Icon="folder" Content="Открыть папку с логами" Command="{Binding OpenLogsCommand}" />
                                <Button Height="40" Padding="12,0" Style="{StaticResource Btn.Secondary}"
                                        ctl:Ui.Icon="clipboard" Content="Скопировать диагностику" Command="{Binding CopyDiagnosticsCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,20,0,0" Padding="22" Style="{StaticResource Card}">
                        <StackPanel>
                            <ToggleButton Style="{StaticResource Toggle.Section}" Content="Для опытных" IsChecked="{Binding AdvancedOpen}" />
                            <StackPanel Margin="0,14,0,0" Visibility="{Binding AdvancedOpen, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource T.Label}" Text="Порт приложения" />
                                <DockPanel Margin="0,7,0,0">
                                    <TextBox DockPanel.Dock="Left" Width="120" Style="{StaticResource TextBox.Field}" MaxLength="5"
                                             FontFamily="{StaticResource FontMono}" FontWeight="{StaticResource Mono500}"
                                             ctl:Ui.HasError="{Binding HasPortError}" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" FontSize="14" VerticalAlignment="Center"
                                            Content="Сбросить" Command="{Binding ResetPortCommand}" />
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Tx3}"
                                               Text="{Binding DefaultPortHint}" />
                                </DockPanel>
                                <TextBlock Margin="0,7,0,0" Style="{StaticResource T.Hint}"
                                           Text="Меняйте, только если порт занят другой программой или вы пробрасываете порт на роутере."
                                           Visibility="{Binding HasPortError, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                <TextBlock Margin="0,7,0,0" FontSize="13" Foreground="{DynamicResource Er}" Text="{Binding PortError}"
                                           Visibility="{Binding HasPortError, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
