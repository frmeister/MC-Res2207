<!-- 1a. Первый запуск -->
<UserControl x:Class="ConnectTogether.App.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:ConnectTogether.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="64" Height="64" CornerRadius="16" HorizontalAlignment="Left" Background="{DynamicResource Ac}">
                <ctl:Logo IsMono="True" Width="38" Height="38" Foreground="{DynamicResource AcTx}" />
            </Border>
            <TextBlock Margin="0,18,0,0" Text="ConnectTogether" FontSize="32" LineHeight="40"
                       LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" />
            <TextBlock Margin="0,8,0,0" Text="Играйте с друзьями по сети без настройки роутера" FontSize="17" TextWrapping="Wrap"
                       LineHeight="25" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource Tx2}" />

            <TextBlock Margin="0,32,0,0" Style="{StaticResource T.Label}" Text="Ваше имя в комнате" />
            <TextBox x:Name="NameBox" Margin="0,8,0,0" Style="{StaticResource TextBox.Large}"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource T.Hint}"
                       Text="Его увидят друзья в списке игроков. Поменять можно в настройках." />

            <Button Margin="0,32,0,0" Style="{StaticResource Btn.Primary}" Height="48" FontSize="16" IsDefault="True"
                    ctl:Ui.CornerRadius="10" ctl:Ui.TrailingIcon="arrowRight" ctl:Ui.IconSize="18"
                    Content="Продолжить" Command="{Binding ContinueCommand}" />
        </StackPanel>

        <TextBlock Grid.Row="1" Margin="0,0,0,20" HorizontalAlignment="Center" FontSize="12"
                   Foreground="{DynamicResource Tx3}" Text="{Binding VersionText}" />
    </Grid>
</UserControl>
