<!-- 1f. Шаг 3: адрес комнаты для друзей -->
<UserControl x:Class="ConnectTogether.App.Views.InviteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:ConnectTogether.App.Controls">
    <UserControl.Resources>
        <!-- Подсказка про сеть: обычная (акцентная) или предупреждение, если из интернета подключиться не получится -->
        <Style x:Key="HintBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AcSoft}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Ac}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource WnSoft}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Wn}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <ctl:WizardHeader DockPanel.Dock="Top" Step="3" />

        <Border DockPanel.Dock="Bottom" Padding="32,20" BorderBrush="{DynamicResource Bd}" BorderThickness="0,1,0,0">
            <Button HorizontalAlignment="Right" Padding="20,0" Style="{StaticResource Btn.Secondary}" ctl:Ui.TrailingIcon="arrowRight"
                    Content="Перейти в комнату" Command="{Binding GoToRoomCommand}" />
        </Border>

        <StackPanel Width="640" Margin="0,0,0,16" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource T.ScreenTitle}" Text="Комната создана" />
            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="15" Foreground="{DynamicResource Tx2}"
                       Text="Отправьте этот адрес друзьям. Он работает, пока комната открыта." />

            <Border Margin="0,24,0,0" Padding="40,22" HorizontalAlignment="Center" CornerRadius="18"
                    Background="{DynamicResource Sf}" BorderBrush="{DynamicResource Bd2}" BorderThickness="1">
                <ctl:SpacedText Text="{Binding Address}" FontFamily="{StaticResource FontMono}" FontWeight="{StaticResource Mono700}"
                                FontSize="42" LineHeight="50" Spacing="1" DimChars=".:" />
            </Border>
            <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="13" Foreground="{DynamicResource Tx3}"
                       Visibility="{Binding LanAddress, Converter={StaticResource NullToCollapsed}}">
                <Run Text="Для друзей в той же сети:" />
                <Run Text="{Binding LanAddress, Mode=OneWay}" FontFamily="{StaticResource FontMono}" Foreground="{DynamicResource Tx2}" />
            </TextBlock>

            <StackPanel Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Height="46" Padding="20,0" FontSize="15" Style="{StaticResource Btn.Primary}" ctl:Ui.CornerRadius="10"
                        ctl:Ui.Icon="{Binding CopyIcon}" ctl:Ui.IconSize="17" Content="{Binding CopyLabel}" Command="{Binding CopyAddressCommand}" />
                <Button Margin="10,0,0,0" Height="46" Padding="20,0" FontSize="15" Style="{StaticResource Btn.Secondary}"
                        ctl:Ui.CornerRadius="10" ctl:Ui.Icon="message" ctl:Ui.IconSize="17"
                        Content="Скопировать сообщение для друга" Command="{Binding CopyMessageCommand}" />
            </StackPanel>

            <ctl:DashedBorder Margin="0,24,0,0" Padding="16,14" CornerRadius="10" StrokeThickness="1">
                <TextBlock Text="{Binding QuotedMessage}" FontSize="14" LineHeight="21" LineStackingStrategy="BlockLineHeight"
                           TextWrapping="Wrap" Foreground="{DynamicResource Tx2}" />
            </ctl:DashedBorder>

            <Border Margin="0,14,0,0" Padding="16,12" CornerRadius="12" Style="{StaticResource HintBox}">
                <DockPanel>
                    <ctl:Icon DockPanel.Dock="Left" Kind="info" Width="18" Height="18" Margin="0,1,0,0" VerticalAlignment="Top" />
                    <TextBlock Margin="12,0,0,0" FontSize="13" LineHeight="19" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                               Foreground="{DynamicResource Tx2}" Text="{Binding NetworkHint}" />
                </DockPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</UserControl>
