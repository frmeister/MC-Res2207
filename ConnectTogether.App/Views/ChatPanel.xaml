<!-- Чат комнаты: общий для комнаты хоста и комнаты игрока. DataContext — RoomScreenBase. -->
<UserControl x:Class="ConnectTogether.App.Views.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:ConnectTogether.App.Controls"
             xmlns:vm="clr-namespace:ConnectTogether.App.ViewModels">
    <Border Style="{StaticResource Card}" ClipToBounds="True">
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="16,13" BorderBrush="{DynamicResource Bd}" BorderThickness="0,0,0,1">
                <TextBlock Style="{StaticResource T.PanelTitle}" Text="Чат комнаты" />
            </Border>

            <Border DockPanel.Dock="Bottom" Padding="12" BorderBrush="{DynamicResource Bd}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource Btn.IconSquare}" ctl:Ui.Icon="send"
                            Command="{Binding SendCommand}" ToolTip="Отправить" AutomationProperties.Name="Отправить" />
                    <TextBox Style="{StaticResource TextBox.Chat}" Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SendCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
            </Border>

            <Grid>
                <TextBlock Margin="20,0" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" FontSize="13" LineHeight="19" LineStackingStrategy="BlockLineHeight"
                           Foreground="{DynamicResource Tx3}" Text="Сообщений пока нет. Их увидят все, кто в комнате."
                           Visibility="{Binding HasChat, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False"
                              Visibility="{Binding HasChat, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl x:Name="Messages" Margin="16,14" VerticalAlignment="Bottom" ItemsSource="{Binding Chat}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChatItem}">
                                <Grid x:Name="Row" Margin="0,12,0,0">
                                    <StackPanel x:Name="Message" HorizontalAlignment="Left">
                                        <TextBlock x:Name="Author" Text="{Binding Author}" FontSize="12" Foreground="{DynamicResource Tx3}"
                                                   HorizontalAlignment="Left" />
                                        <Border x:Name="Bubble" Margin="0,3,0,0" Padding="11,8" MaxWidth="240" CornerRadius="10"
                                                HorizontalAlignment="Left" Background="{DynamicResource Sf3}">
                                            <TextBlock Text="{Binding Text}" FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="System" Text="{Binding Text}" FontSize="12" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource Tx3}" Visibility="Collapsed" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                        <Setter TargetName="Row" Property="Margin" Value="0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMine}" Value="True">
                                        <Setter TargetName="Message" Property="HorizontalAlignment" Value="Right" />
                                        <Setter TargetName="Author" Property="HorizontalAlignment" Value="Right" />
                                        <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                        <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource AcSoft}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                        <Setter TargetName="Message" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="System" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
