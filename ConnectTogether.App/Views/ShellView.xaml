<!-- Оболочка окна: заголовок с навигацией (CT Titlebar), текущий экран и тосты снизу справа. -->
<UserControl x:Class="ConnectTogether.App.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:ConnectTogether.App.Controls"
             xmlns:vm="clr-namespace:ConnectTogether.App.ViewModels"
             xmlns:svc="clr-namespace:ConnectTogether.App.Services"
             xmlns:views="clr-namespace:ConnectTogether.App.Views">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:OnboardingViewModel}"><views:OnboardingView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChooseGameViewModel}"><views:ChooseGameView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServerCheckViewModel}"><views:ServerCheckView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InviteViewModel}"><views:InviteView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:JoinViewModel}"><views:JoinView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConnectingViewModel}"><views:ConnectingView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HostRoomViewModel}"><views:HostRoomView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlayerRoomViewModel}"><views:PlayerRoomView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:IntegrationsViewModel}"><views:IntegrationsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StateViewModel}"><views:StateView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConnectionLostViewModel}"><views:StateView /></DataTemplate>

        <!-- Тост: иконка + текст + действие + закрыть -->
        <DataTemplate x:Key="ToastTemplate" DataType="{x:Type svc:Toast}">
            <Border Margin="0,8,0,0" Padding="14,11,12,11" CornerRadius="10" Background="{DynamicResource Sf3}"
                    BorderBrush="{DynamicResource Bd2}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.35" Color="Black" />
                </Border.Effect>
                <DockPanel>
                    <ctl:Icon x:Name="ToastIcon" DockPanel.Dock="Left" Kind="{Binding Icon}" Width="18" Height="18"
                              Foreground="{DynamicResource Ok}" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Caption}" Width="22" Height="22" Margin="8,0,0,0"
                            ctl:Ui.Icon="close" ctl:Ui.IconStroke="1.8" Foreground="{DynamicResource Tx3}"
                            ctl:Ui.CornerRadius="6" Command="{Binding CloseCommand}" ToolTip="Закрыть" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" FontSize="13" FontWeight="SemiBold"
                            Margin="10,0,0,0" VerticalAlignment="Center" Content="{Binding ActionLabel}" Command="{Binding ActionCommand}"
                            Visibility="{Binding ActionLabel, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock Margin="10,0,0,0" FontSize="14" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static svc:ToastKind.Info}">
                    <Setter TargetName="ToastIcon" Property="Foreground" Value="{DynamicResource Ac}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static svc:ToastKind.Warning}">
                    <Setter TargetName="ToastIcon" Property="Foreground" Value="{DynamicResource Wn}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- Заголовок окна -->
        <Border Background="{DynamicResource Sf}" BorderBrush="{DynamicResource Bd}" BorderThickness="0,0,0,1">
            <DockPanel>
                <ctl:Logo DockPanel.Dock="Left" Width="20" Height="20" Margin="14,0,0,0" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Left" Margin="10,0,0,0" VerticalAlignment="Center" Text="ConnectTogether"
                           FontSize="13" FontWeight="SemiBold" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource Btn.Caption}" ctl:Ui.Icon="min" Click="OnMinimize"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Свернуть" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource Btn.Caption}" ctl:Ui.Icon="max" ctl:Ui.IconSize="12"
                            Click="OnMaximize" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Развернуть" />
                    <Button Style="{StaticResource Btn.CaptionClose}" ctl:Ui.Icon="close" Click="OnClose"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Закрыть" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center"
                            Visibility="{Binding ShowNav, Converter={StaticResource BoolToVisibility}}">
                    <Button Style="{StaticResource Btn.Tab}" Content="Главная" ctl:Ui.Icon="home"
                            ctl:Ui.IsActive="{Binding IsHomeTab}" Command="{Binding HomeCommand}"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource Btn.Tab}" Content="Интеграции" ctl:Ui.Icon="puzzle" Margin="2,0,0,0"
                            ctl:Ui.IsActive="{Binding IsIntegrationsTab}" Command="{Binding IntegrationsCommand}"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource Btn.Tab}" Content="Настройки" ctl:Ui.Icon="sliders" Margin="2,0,0,0"
                            ctl:Ui.IsActive="{Binding IsSettingsTab}" Command="{Binding SettingsCommand}"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
                <Border />
            </DockPanel>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding Current}" Focusable="False" />

        <ItemsControl Grid.Row="1" Width="360" Margin="0,0,16,16" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      ItemsSource="{Binding Toasts}" ItemTemplate="{StaticResource ToastTemplate}" Focusable="False" />
    </Grid>
</UserControl>
