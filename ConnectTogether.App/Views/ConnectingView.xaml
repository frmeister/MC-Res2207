<!-- 1h. Подключение к комнате -->
<UserControl x:Class="ConnectTogether.App.Views.ConnectingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:ConnectTogether.App.Controls"
             xmlns:vm="clr-namespace:ConnectTogether.App.ViewModels">
    <StackPanel Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource T.ScreenTitle}" Text="Подключаемся к комнате" />
        <TextBlock Margin="0,6,0,0" FontSize="15" Foreground="{DynamicResource Tx2}">
            <Run Text="{Binding SubtitlePrefix, Mode=OneWay}" /><Run Text="{Binding Address, Mode=OneWay}" FontFamily="{StaticResource FontMono}"
                 Foreground="{DynamicResource Tx}" />
        </TextBlock>

        <Border Margin="0,26,0,0" Padding="24,22" Style="{StaticResource Card14}">
            <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ConnectStep}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <!-- Индикатор этапа и линия к следующему -->
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Width="28" Height="28">
                                    <Border x:Name="DoneMark" CornerRadius="14" Background="{DynamicResource OkSoft}" Visibility="Collapsed">
                                        <ctl:Icon Kind="check" StrokeWidth="2.6" Width="15" Height="15" Foreground="{DynamicResource Ok}" />
                                    </Border>
                                    <ctl:Spinner x:Name="ActiveMark" Width="22" Height="22" Visibility="Collapsed" />
                                    <Border x:Name="PendingMark" CornerRadius="14" BorderThickness="2" BorderBrush="{DynamicResource Bd2}" />
                                </Grid>
                                <Border x:Name="Line" Width="2" MinHeight="22" Background="{DynamicResource Bd2}" />
                            </DockPanel>

                            <StackPanel x:Name="Body" Grid.Column="2" Margin="0,3,0,18">
                                <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="16" />
                                <TextBlock x:Name="Note" Margin="0,2,0,0" Text="{Binding Note}" FontSize="13" Foreground="{DynamicResource Tx3}"
                                           Visibility="{Binding Note, Converter={StaticResource NullToCollapsed}}" />
                                <StackPanel x:Name="Progress" Visibility="Collapsed"
                                            DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                    <Grid Margin="0,8,0,0" Height="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding Progress, Converter={StaticResource ProgressToStar}}" />
                                            <ColumnDefinition Width="{Binding Progress, Converter={StaticResource ProgressToStar}, ConverterParameter=rest}" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.ColumnSpan="2" CornerRadius="3" Background="{DynamicResource Sf3}" />
                                        <Border CornerRadius="3" Background="{DynamicResource Ac}" />
                                    </Grid>
                                    <TextBlock Margin="0,8,0,0" FontSize="13" Foreground="{DynamicResource Tx2}"
                                               Text="{Binding ElapsedText}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:StepState.Done}">
                                <Setter TargetName="DoneMark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="PendingMark" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Line" Property="Background" Value="{DynamicResource Ok}" />
                                <Setter TargetName="Line" Property="Opacity" Value="0.5" />
                                <Setter TargetName="Title" Property="FontWeight" Value="Medium" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:StepState.Active}">
                                <Setter TargetName="ActiveMark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="PendingMark" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Progress" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:StepState.Pending}">
                                <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource Tx3}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLast}" Value="True">
                                <Setter TargetName="Line" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Body" Property="Margin" Value="0,4,0,0" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border Margin="0,16,0,0" Padding="16,14" Style="{StaticResource Card}"
                Visibility="{Binding ShowMyAddress, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock FontSize="14" FontWeight="SemiBold" Text="Хост долго не отвечает?" />
                <TextBlock Margin="0,4,0,0" FontSize="13" LineHeight="19" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                           Foreground="{DynamicResource Tx2}"
                           Text="Возможно, его роутер не пропускает входящие подключения. Отправьте хосту ваш адрес — он нажмёт «Впустить по адресу» в своей комнате, а подключение здесь продолжится само." />
                <DockPanel Margin="0,12,0,0">
                    <Button DockPanel.Dock="Right" Height="38" Padding="14,0" Style="{StaticResource Btn.Secondary}" ctl:Ui.Icon="copy"
                            Content="{Binding CopyLabel}" Command="{Binding CopyMyAddressCommand}" />
                    <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Tx3}">
                        <Run Text="Ваш адрес для хоста:" />
                        <Run Text="{Binding MyAddress, Mode=OneWay}" FontFamily="{StaticResource FontMono}" FontWeight="{StaticResource Mono600}"
                             FontSize="15" Foreground="{DynamicResource Tx}" />
                    </TextBlock>
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Margin="0,26,0,0" Padding="16,14" CornerRadius="12" Background="{DynamicResource AcSoft}">
            <DockPanel>
                <ctl:Icon DockPanel.Dock="Left" Kind="info" Width="18" Height="18" Margin="0,1,0,0" VerticalAlignment="Top"
                          Foreground="{DynamicResource Ac}" />
                <TextBlock Margin="12,0,0,0" FontSize="14" LineHeight="21" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap">
                    <Run Text="Всё идёт нормально." FontWeight="SemiBold" />
                    <Run Text="{Binding HostHint, Mode=OneWay}" Foreground="{DynamicResource Tx2}" />
                </TextBlock>
            </DockPanel>
        </Border>

        <Button Margin="0,26,0,0" HorizontalAlignment="Left" Style="{StaticResource Btn.Secondary}" Content="Отменить"
                Command="{Binding CancelCommand}" IsCancel="True" />
    </StackPanel>
</UserControl>
